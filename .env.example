# Local template. Keep real credentials in .env, not in this file.
# Training through run.py uses a run YAML for paths, models, tasks, and W&B configuration.

# Dataset path for preprocessing and CoT generation.
TRIAGE_DATASET_ROOT="/path/to/airlab/dataset-root"

# Optional: CoT generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-4-argon
GEMINI_VIDEO_FPS=source
GEMINI_MEDIA_RESOLUTION=high
GEMINI_REASONING_EFFORT=high
GEMINI_MAX_OUTPUT_TOKENS=8192
# Uploaded-file cache defaults to ~/.cache/triage-cot.
# COT_CACHE_DIR=

# Training credentials. W&B project, entity, and mode belong in the run YAML.
WANDB_API_KEY=

# OpenStack application credentials for authenticated storage access.
OS_AUTH_URL=
AIRLAB_APPLICATION_CREDENTIAL_FILE=

# Alternative S3 authentication. Configure only one storage authentication method.
AIRLAB_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional compatibility defaults for standalone preparation/storage commands
# and direct training entry points. These are not required by run.py.
LOCAL_DATASET_ROOT=/path/to/local/dataset-root
LOCAL_WEIGHTS_ROOT=/path/to/local/model-storage
