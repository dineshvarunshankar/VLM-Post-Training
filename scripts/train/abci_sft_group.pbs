#!/usr/bin/env bash
# Submit from the repository root, after reviewing configs/abci/sft_two_nodes.json.
# qsub -v RTYPE=rt_HF,ABCI_SFT_NODE=node_a scripts/train/abci_sft_group.pbs
# qsub -v RTYPE=rt_HF,ABCI_SFT_NODE=node_b scripts/train/abci_sft_group.pbs
#PBS -P gai51740
#PBS -q R9920261300
#PBS -N triage-sft-group
#PBS -l select=1
#PBS -l walltime=168:00:00
#PBS -j oe
set -euo pipefail
: "${ABCI_SFT_NODE:?Set ABCI_SFT_NODE to a node name in the selected plan}"
: "${PBS_O_WORKDIR:?Submit from the repository root}"
cd "$PBS_O_WORKDIR"
test -f scripts/train/launch_abci_group.py
exec python3 scripts/train/launch_abci_group.py --plan "${ABCI_SFT_PLAN:-scripts/train/configs/abci/sft_two_nodes.json}" --node "$ABCI_SFT_NODE" --run
