+def _get_video_max_frames(video_opts: VideoDummyOptions | None) -> int:
+    """Use the explicit profiling bound instead of capping it at the default."""
+    if isinstance(video_opts, VideoDummyOptions) and video_opts.num_frames is not None:
+        return video_opts.num_frames
+    return _VIDEO_MAX_FRAMES
+
+
+def _get_video_max_soft_tokens(merged_kwargs: Mapping[str, object]) -> int:
+    """Resolve the video-only frame budget without changing image settings."""
+    video_kwargs = merged_kwargs.get("videos_kwargs", {})
+    value = video_kwargs.get("max_soft_tokens", _VIDEO_MAX_SOFT_TOKENS)
+    if type(value) is not int or value not in _SUPPORTED_SOFT_TOKENS:
+        raise ValueError(
+            f"Unsupported video max_soft_tokens: {value}. "
+            f"Valid values are {_SUPPORTED_SOFT_TOKENS}."
+        )
+    return value
+
